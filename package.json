{
  "name": "ricada",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run examples/run.ts",
    "start": "bun run examples/run.ts",
    "check": "bun run packages/cli/src/bin.ts check examples/basic.ricada",
    "gen": "bun run packages/cli/src/bin.ts gen examples/basic.ricada",
    "mock": "bun run packages/cli/src/bin.ts mock examples/basic.ricada",
    "test:api": "bun run packages/cli/src/bin.ts test examples/basic.ricada",
    "lsp": "bun run packages/lsp/src/server.ts --stdio",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ricada/cli": "workspace:*",
    "@ricada/core": "workspace:*",
    "@ricada/emitter-openapi": "workspace:*",
    "@ricada/emitter-ts-client": "workspace:*",
    "@ricada/emitter-ts-common": "workspace:*",
    "@ricada/emitter-ts-server": "workspace:*",
    "@ricada/lsp": "workspace:*",
    "@ricada/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2"
  }
}
